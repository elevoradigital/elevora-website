# ==============================================================================
# ELEVORA Studio — Environment Configuration
# ==============================================================================

# 1. Transactional Email Provider (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=

# 2. Business Email Destination
# The inbox where ELEVORA receives client enquiries (must be real, verified Gmail/business email)
CONTACT_EMAIL=elevoradigital.in@gmail.com

# 3. Sender Identity
# For initial testing: ELEVORA <onboarding@resend.dev>
# For production with verified custom domain: ELEVORA <hello@elevora.in>
EMAIL_FROM=ELEVORA <onboarding@resend.dev>

# 4. WhatsApp Business Number (international format without '+' or spaces)
WHATSAPP_NUMBER=919444949868
